# 服务配置
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# 日志配置
# 可选值: debug, info, warn, error
LOG_LEVEL=info

# CORS 配置
CORS_ALLOW_ORIGIN=*

# QQ 免登录访问配置：填写独立密钥后，启动时自动创建 stateless QQ 配置。
# 客户端仍通过 Authorization 携带此密钥访问 /v1/*。
QQ_API_ACCESS_KEY=
QQ_ACCOUNT_NAME=QQ 音乐（免登录）

# 洛雪自定义源（QQ 播放必填，QQ 固定使用洛雪）
# 按 LX_SOURCE_URL、LX_SOURCE_URL0 至 LX_SOURCE_URL9 的顺序调用
# LX_SOURCE_URL=https://example.com/lx-source-primary.js
# LX_SOURCE_URL0=https://example.com/lx-source-backup.js

# 可选管理员密码；空值禁用网页管理员模式（Cloudflare 请配置同名运行时 Secret）
# ADMIN_MANAGEMENT_PASSWORD=
